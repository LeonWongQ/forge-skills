{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/registry/schemas/behaviors.schema.json",
  "title": "Forge Behaviors Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "behaviors"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "behaviors": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/behavior" }
    }
  },
  "$defs": {
    "behaviorId": { "type": "string", "pattern": "^behavior\\.[A-Za-z0-9_]+$" },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "name"],
      "properties": {
        "id":   { "$ref": "#/$defs/behaviorId" },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "primary_use_cases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "activation_signals": { "type": "object" },
        "default_template": {
          "anyOf": [
            { "type": "string", "pattern": "^template\\.[A-Za-z0-9_]+$" },
            { "type": "null" }
          ]
        },
        "default_checklists": {
          "type": "array",
          "items": { "type": "string", "pattern": "^checklist\\.[A-Za-z0-9_]+$" }
        }
      }
    }
  }
}
