{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.local/registry/schemas/checklists.schema.json",
  "title": "Forge Checklists Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "checklists"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "checklists": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/checklist" }
    }
  },
  "$defs": {
    "checklistId": { "type": "string", "pattern": "^checklist\\.[A-Za-z0-9_]+$" },
    "checklist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "name"],
      "properties": {
        "id":   { "$ref": "#/$defs/checklistId" },
        "path": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "recommended_for_behaviors": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "recommended_for_conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
