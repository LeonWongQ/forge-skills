{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry/schemas/compositions.schema.json",
  "title": "Compositions Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "description", "compositions"],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "compositions": {
      "type": "array",
      "items": { "$ref": "#/$defs/compositionEntry" }
    }
  },
  "$defs": {
    "compositionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "match_hints",
        "primary_behavior",
        "secondary_behaviors",
        "domains",
        "workflow",
        "template",
        "checklists"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^composition\\.[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "match_hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_behavior": {
          "type": "string",
          "pattern": "^behavior\\.[a-z0-9_]+$"
        },
        "secondary_behaviors": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^behavior\\.[a-z0-9_]+$"
          }
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^domain\\.[a-z0-9_]+$"
          }
        },
        "workflow": {
          "type": "string",
          "pattern": "^workflow\\.[a-z0-9_]+$"
        },
        "template": {
          "type": "string",
          "pattern": "^template\\.[a-z0-9_]+$"
        },
        "checklists": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^checklist\\.[a-z0-9_]+$"
          }
        }
      }
    }
  }
}
