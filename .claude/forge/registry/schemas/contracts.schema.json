{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry/schemas/contracts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "contracts"],
  "properties": {
    "version": {"type": "string"},
    "description": {"type": "string"},
    "contracts": {"type": "array", "items": {"$ref": "#/$defs/contract"}}
  },
  "$defs": {
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!.*\\.\\.).+\\.json$"},
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "format", "baseline_schema", "current_schema", "compatibility", "fixtures"],
      "properties": {
        "id": {"type": "string", "pattern": "^contract\\.[a-z0-9_]+$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"enum": ["api", "event"]},
        "format": {"const": "json-schema"},
        "baseline_schema": {"$ref": "#/$defs/path"},
        "current_schema": {"$ref": "#/$defs/path"},
        "compatibility": {
          "type": "object", "additionalProperties": false,
          "required": ["baseline_to_current", "current_to_baseline"],
          "properties": {
            "baseline_to_current": {"enum": ["required", "not_required"]},
            "current_to_baseline": {"enum": ["required", "not_required"]}
          }
        },
        "fixtures": {
          "type": "object", "additionalProperties": false,
          "required": ["baseline_valid", "current_valid", "invalid"],
          "properties": {
            "baseline_valid": {"type": "array", "items": {"$ref": "#/$defs/path"}},
            "current_valid": {"type": "array", "items": {"$ref": "#/$defs/path"}},
            "invalid": {"type": "array", "items": {"$ref": "#/$defs/path"}}
          }
        }
      }
    }
  }
}
