{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry/schemas/packs.schema.json",
  "title": "Pack Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "purpose",
    "when_to_use",
    "modules",
    "workflow",
    "template",
    "checklists"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^pack\\.[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "when_to_use": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "modules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernel", "runtime", "behaviors", "domains"],
      "properties": {
        "kernel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^kernel\\.[a-z0-9_]+$"
          }
        },
        "runtime": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^runtime\\.[a-z0-9_]+$"
          }
        },
        "behaviors": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "string",
            "pattern": "^behavior\\.[a-z0-9_]+$"
          }
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^domain\\.[a-z0-9_]+$"
          }
        },
        "engine": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^engine\\.[a-z0-9_]+$"
          }
        }
      }
    },
    "workflow": {
      "type": "string",
      "pattern": "^workflow\\.[a-z0-9_]+$"
    },
    "template": {
      "type": "string",
      "pattern": "^template\\.[a-z0-9_]+$"
    },
    "checklists": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^checklist\\.[a-z0-9_]+$"
      }
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^report\\.[a-z0-9_]+$"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preferred_skill": {
          "type": "string",
          "pattern": "^skill\\.[A-Za-z0-9_]+$"
        },
        "score_bonus": {
          "type": "integer",
          "minimum": 0
        },
        "keywords_any": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "keywords_all_groups": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
