{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry/schemas/runtime-state.schema.json",
  "title": "Runtime State Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_statement",
    "user_goal",
    "primary_behavior",
    "secondary_behaviors",
    "active_domains",
    "workflow",
    "template",
    "checklists",
    "scope",
    "constraints",
    "assumptions",
    "evidence",
    "findings",
    "verification_status",
    "open_questions",
    "confidence"
  ],
  "properties": {
    "task_statement": {
      "type": "string",
      "minLength": 1
    },
    "user_goal": {
      "type": "string",
      "minLength": 1
    },
    "primary_behavior": {
      "type": "string",
      "pattern": "^behavior\\.[a-z0-9_]+$"
    },
    "secondary_behaviors": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^behavior\\.[a-z0-9_]+$"
      }
    },
    "active_domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^domain\\.[a-z0-9_]+$"
      }
    },
    "workflow": {
      "type": "string",
      "pattern": "^workflow\\.[a-z0-9_]+$"
    },
    "template": {
      "type": "string",
      "pattern": "^template\\.[a-z0-9_]+$"
    },
    "checklists": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^checklist\\.[a-z0-9_]+$"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceItem" }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/findingItem" }
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "verified", "unverified"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["none", "partial", "full"]
        },
        "verified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "observation", "type", "confidence"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": [
            "code",
            "log",
            "test",
            "config",
            "trace",
            "user_report",
            "query",
            "runtime_behavior",
            "other"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "relevance": {
          "type": "string"
        }
      }
    },
    "findingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "kind", "confidence"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "finding",
            "hypothesis",
            "risk",
            "recommendation",
            "root_cause_candidate",
            "tradeoff"
          ]
        },
        "summary": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
