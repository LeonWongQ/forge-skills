{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry/schemas/template-test-plan-output.schema.json",
  "title": "Test Plan Output Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "basic_information",
    "objective",
    "scope",
    "test_strategy",
    "entry_criteria",
    "exit_criteria"
  ],
  "properties": {
    "basic_information": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "plan_owner"],
      "properties": {
        "project": { "type": "string", "minLength": 1 },
        "module": { "type": "string" },
        "version": { "type": "string" },
        "plan_owner": { "type": "string", "minLength": 1 },
        "date": { "type": "string" }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_purpose", "quality_objectives", "key_risks"],
      "properties": {
        "test_purpose": { "type": "string", "minLength": 1 },
        "quality_objectives": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "key_risks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "test_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approach"],
      "properties": {
        "approach": { "type": "string", "minLength": 1 },
        "levels": { "type": "array", "items": { "type": "string" } },
        "types": { "type": "array", "items": { "type": "string" } },
        "risk_based_focus": { "type": "array", "items": { "type": "string" } }
      }
    },
    "test_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/testItem" }
    },
    "test_scenarios": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "alternative": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "exception": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "boundary": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "environment_and_resources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environments": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "test_data": { "type": "string" },
        "mock_strategy": { "type": "string" }
      }
    },
    "entry_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "exit_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "schedule": {
      "type": "array",
      "items": { "$ref": "#/$defs/schedulePhase" }
    },
    "roles_and_responsibilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test_owner": { "type": "string" },
        "test_executors": { "type": "array", "items": { "type": "string" } },
        "developers": { "type": "array", "items": { "type": "string" } },
        "product_business": { "type": "array", "items": { "type": "string" } },
        "ops_support": { "type": "array", "items": { "type": "string" } }
      }
    },
    "deliverables": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "risks_and_mitigation": {
      "type": "array",
      "items": { "$ref": "#/$defs/riskItem" }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prepared_by": { "type": "string" },
        "reviewed_by": { "type": "string" },
        "confirmed_by": { "type": "string" }
      }
    }
  },
  "$defs": {
    "testItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "description", "priority", "owner"],
      "properties": {
        "item": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "test_type": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 }
      }
    },
    "schedulePhase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "start", "end", "owner", "output"],
      "properties": {
        "phase": { "type": "string", "minLength": 1 },
        "start": { "type": "string" },
        "end": { "type": "string" },
        "owner": { "type": "string", "minLength": 1 },
        "output": { "type": "string" }
      }
    },
    "riskItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "impact", "mitigation"],
      "properties": {
        "risk": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "mitigation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
